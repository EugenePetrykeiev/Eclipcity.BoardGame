#!/bin/bash
set -euo pipefail

export AWS_DEFAULT_REGION="${aws_region}"

dnf update -y
dnf install -y postgresql16 postgresql16-server postgresql16-contrib jq awscli

SECRET_JSON=""

for attempt in $(seq 1 30); do
  if SECRET_JSON="$(aws secretsmanager get-secret-value \
      --region "${aws_region}" \
      --secret-id "${db_secret_arn}" \
      --query SecretString \
      --output text 2>/tmp/get-db-secret.err)"; then
    break
  fi

  sleep 5
done

if [ -z "$SECRET_JSON" ]; then
  echo "Failed to read database secret from AWS Secrets Manager." >&2
  cat /tmp/get-db-secret.err >&2 || true
  exit 1
fi

DB_USER="$(printf '%s' "$SECRET_JSON" | jq -r '.username // empty')"
DB_PASSWORD="$(printf '%s' "$SECRET_JSON" | jq -r '.password // empty')"
DB_NAME="$(printf '%s' "$SECRET_JSON" | jq -r '.dbname // empty')"

if [ -z "$DB_USER" ] || [ -z "$DB_PASSWORD" ] || [ -z "$DB_NAME" ]; then
  echo "Secret must contain username, password, and dbname." >&2
  exit 1
fi

case "$DB_USER" in
  *[!a-zA-Z0-9_]*)
    echo "Database username must contain only letters, numbers, and underscores." >&2
    exit 1
    ;;
esac

case "$DB_NAME" in
  *[!a-zA-Z0-9_]*)
    echo "Database name must contain only letters, numbers, and underscores." >&2
    exit 1
    ;;
esac

if command -v postgresql-16-setup >/dev/null 2>&1; then
  postgresql-16-setup initdb
else
  postgresql-setup --initdb
fi

PG_SERVICE="postgresql-16"

if ! systemctl list-unit-files | grep -q '^postgresql-16.service'; then
  PG_SERVICE="postgresql"
fi

systemctl enable --now "$PG_SERVICE"

PGDATA="$(sudo -iu postgres psql -tAc "show data_directory" | xargs)"

cp "$PGDATA/postgresql.conf" "$PGDATA/postgresql.conf.bak"
cp "$PGDATA/pg_hba.conf" "$PGDATA/pg_hba.conf.bak"

sed -i "s/^#listen_addresses = .*/listen_addresses = '*'/g" "$PGDATA/postgresql.conf"

if ! grep -q "^listen_addresses = '\\*'" "$PGDATA/postgresql.conf"; then
  echo "listen_addresses = '*'" >> "$PGDATA/postgresql.conf"
fi

HBA_LINE="host $DB_NAME $DB_USER ${postgres_client_cidr} scram-sha-256"

if ! grep -qxF "$HBA_LINE" "$PGDATA/pg_hba.conf"; then
  echo "$HBA_LINE" >> "$PGDATA/pg_hba.conf"
fi

sql_escape() {
  printf "%s" "$1" | sed "s/'/''/g"
}

DB_USER_ESC="$(sql_escape "$DB_USER")"
DB_PASSWORD_ESC="$(sql_escape "$DB_PASSWORD")"
DB_NAME_ESC="$(sql_escape "$DB_NAME")"

SQL_FILE="$(mktemp /dev/shm/bootstrap-postgres.XXXXXX.sql)"
chmod 600 "$SQL_FILE"

cat > "$SQL_FILE" <<SQL
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', '$DB_USER_ESC', '$DB_PASSWORD_ESC')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '$DB_USER_ESC') \gexec

SELECT format('ALTER ROLE %I WITH PASSWORD %L', '$DB_USER_ESC', '$DB_PASSWORD_ESC') \gexec

SELECT format('CREATE DATABASE %I OWNER %I', '$DB_NAME_ESC', '$DB_USER_ESC')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = '$DB_NAME_ESC') \gexec

SELECT format('GRANT ALL PRIVILEGES ON DATABASE %I TO %I', '$DB_NAME_ESC', '$DB_USER_ESC') \gexec
SQL

sudo -iu postgres psql -v ON_ERROR_STOP=1 < "$SQL_FILE"

rm -f "$SQL_FILE"

systemctl restart "$PG_SERVICE"

echo "PostgreSQL ready. Database and user were created from AWS Secrets Manager." > /var/log/postgres-user-data.done