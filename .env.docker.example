# Local Docker Compose values only. Never put production credentials here.
FRONTEND_PORT=80
LOCAL_ORIGIN=http://localhost

POSTGRES_DB=eclipcity_local
POSTGRES_USER=eclipcity_local
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_SSL_MODE=disable

# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional local Google OAuth configuration.
# Authorized redirect URI:
# http://localhost/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional local SMTP/SES configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@eclipcity.digitee.space
SMTP_FROM_NAME=Eclipcity
SMTP_USE_TLS=true
