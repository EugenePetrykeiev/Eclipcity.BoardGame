#!/usr/bin/env bash
set -euo pipefail

for attempt in $(seq 1 30); do
  if dnf install -y docker jq; then
    break
  fi

  if [[ "$${attempt}" -eq 30 ]]; then
    echo "Unable to install base packages after $${attempt} attempts." >&2
    exit 1
  fi

  sleep 10
done

systemctl enable --now docker
systemctl enable --now amazon-ssm-agent
usermod -aG docker ec2-user

compose_workdir="$(mktemp -d)"
compose_asset="docker-compose-linux-aarch64"
compose_base_url="https://github.com/docker/compose/releases/download/${compose_version}"
trap 'rm -rf "$${compose_workdir}"' EXIT

curl --fail --silent --show-error --location \
  "$${compose_base_url}/$${compose_asset}" \
  --output "$${compose_workdir}/$${compose_asset}"
curl --fail --silent --show-error --location \
  "$${compose_base_url}/$${compose_asset}.sha256" \
  --output "$${compose_workdir}/$${compose_asset}.sha256"

(
  cd "$${compose_workdir}"
  sha256sum --check "$${compose_asset}.sha256"
)

install -d -o root -g root -m 0755 /usr/local/lib/docker/cli-plugins
install -o root -g root -m 0755 \
  "$${compose_workdir}/$${compose_asset}" \
  /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

install -d -o root -g root -m 0755 /opt/eclipcity
install -d -o root -g root -m 0755 /opt/eclipcity/bin
install -d -o root -g root -m 0700 /opt/eclipcity/env

cat > /etc/eclipcity-node.conf <<'EOF'
ECLIPCITY_ROLE=${instance_role}
AWS_REGION=${aws_region}
PUBLIC_DOMAIN=${domain_name}
BACKEND_SECRET_ARN=${backend_secret_arn}
EOF

chown root:root /etc/eclipcity-node.conf
chmod 0600 /etc/eclipcity-node.conf

cat > /etc/docker/daemon.json <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "5"
  }
}
EOF

systemctl restart docker
