# Use either DATABASE_URL or the POSTGRES_* fields below.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=disable

FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
POST_AUTH_REDIRECT_PATH=/
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=eclipcity_session
SESSION_COOKIE_MAX_AGE=1209600
SESSION_COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@eclipcity.digitee.space
SMTP_FROM_NAME=Eclipcity
SMTP_USE_TLS=true
