aws_region  = "eu-central-1"
owner       = "platform"
cost_center = "eclipcity"
repository  = "Cartahena"

# Set only after explicitly opting this repository into GitHub immutable OIDC
# subjects. Keep null/default while GitHub uses the classic repository subject.
# github_oidc_subject_override = "repo:OWNER@OWNER_ID/REPO@REPO_ID:environment:dev"

# ARN is environment metadata; never paste the secret JSON itself.
backend_secret_arn = "arn:aws:secretsmanager:eu-central-1:396287094980:secret:eclipcity/dev/backend-UCILpp"

# Existing PostgreSQL EC2 role; Terraform attaches SSM management to it.
# database_instance_role_name = "postgres-t4g-micro-ec2-role"

# Required to create the $25/month account-level budget and email alerts.
# Prefer setting this locally or as TF_VAR_budget_alert_email in CI.
budget_alert_email = "REPLACE_WITH_REAL_EMAIL"

# Optional. Defaults to budget_alert_email when omitted.
# certbot_email = "certificates@example.com"

# Adjust if a different monthly credit burn limit is desired.
monthly_budget_limit_usd = 25

# Set this only when the secret is encrypted with a customer-managed KMS key.
# backend_secret_kms_key_arn = "arn:aws:kms:eu-central-1:123456789012:key/REPLACE"

extra_tags = {
  Application = "game"
}
