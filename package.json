{
  "name": "eclipcity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:backend": ".venv/bin/python -m unittest discover -s tests/backend -p 'test_*.py'",
    "validate:home": "node scripts/validate-home.mjs",
    "validate:user": "node scripts/validate-user.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
